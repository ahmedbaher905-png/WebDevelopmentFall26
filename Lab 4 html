<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Todo App</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(180deg, #eef2fd, #f6f8fe);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .card {
      background: white;
      width: 100%;
      max-width: 700px;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(60, 80, 140, 0.12);
    }

    h1 {
      font-size: 20px;
      color: #111827;
      margin-bottom: 14px;
    }

    .input-area {
      display: flex;
      gap: 8px;
    }

    #todoInput {
      flex: 1;
      padding: 10px 12px;
      font-size: 15px;
      border: 1px solid #e3e7f1;
      border-radius: 8px;
      background: #f8faff;
      outline: none;
    }

    #todoInput:focus {
      border-color: #3b82f6;
    }

    #addBtn {
      background: #3b82f6;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 0 18px;
      font-weight: bold;
      cursor: pointer;
    }

    #addBtn:hover {
      background: #2563eb;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 16px 0 8px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tip {
      font-size: 12px;
      color: #6b7280;
    }

    .filter {
      background: none;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 13px;
      font-weight: bold;
      color: #6b7280;
      cursor: pointer;
    }

    .filter.active {
      background: #e8f0fe;
      border-color: #c7d7fb;
      color: #3b82f6;
    }

    ul {
      list-style: none;
      border-top: 1px solid #eef0f4;
    }

    .todo {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-bottom: 1px solid #eef0f4;
    }

    .toggle {
      width: 16px;
      height: 16px;
      accent-color: #8b5cf6;
      cursor: pointer;
    }

    .text {
      flex: 1;
      font-size: 15px;
      color: #1f2937;
      cursor: text;
    }

    .todo.done .text {
      text-decoration: line-through;
      color: #9ca3af;
    }

    .edit {
      flex: 1;
      font-size: 15px;
      padding: 4px 8px;
      border: 1px solid #3b82f6;
      border-radius: 6px;
      outline: none;
    }

    .delete {
      background: none;
      border: none;
      font-size: 15px;
      cursor: pointer;
      opacity: 0.4;
    }

    .delete:hover {
      opacity: 1;
    }

    .empty {
      padding: 16px;
      text-align: center;
      color: #9ca3af;
      font-size: 14px;
      border-bottom: 1px solid #eef0f4;
    }

    .footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      font-size: 12px;
      color: #6b7280;
    }

    .footer button {
      font-size: 12px;
      padding: 3px 7px;
      margin-left: 4px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Todo App</h1>

    <div class="input-area">
      <input id="todoInput" placeholder="What needs doing?" />
      <button id="addBtn">Add</button>
    </div>

    <div class="toolbar">
      <span class="tip">Tip: double-click a todo to edit. Press Enter to save.</span>
      <div>
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="active">Active</button>
        <button class="filter" data-filter="completed">Completed</button>
      </div>
    </div>

    <ul id="todoList"></ul>

    <div class="footer">
      <span id="count">0 items left</span>
      <div>
        <button id="clearCompleted">Clear completed</button>
        <button id="clearAll">Clear all</button>
      </div>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
